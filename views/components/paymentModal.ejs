<div id="<%= modalId %>" class="modal">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head has-background-link">
            <p class="modal-card-title has-text-white has-text-weight-semibold">Confirmar Datos de Pago</p>
            <button class="delete" type="button" aria-label="close" id="closeModal"></button>
        </header>
        <section class="modal-card-body">
            <div class="content">
                <div class="columns is-multiline">
                    <div class="column is-half">
                        <div class="box" style="border-left: 4px solid #8B4513; background-color: #F0ECE4;">
                            <p class="has-text-weight-semibold">Contrato:</p>
                            <p id="<%= modalId %>-contratoValue" class="is-size-5 has-text-dark"></p>
                        </div>
                    </div>
                    <div class="column is-half">
                        <div class="box" style="border-left: 4px solid #8B4513; background-color: #F0ECE4;">
                            <p class="has-text-weight-semibold">Motivo:</p>
                            <p id="<%= modalId %>-motivoValue" class="is-size-5 has-text-dark"></p>
                        </div>
                    </div>
                    <div class="column is-half">
                        <div class="box" style="border-left: 4px solid #8B4513; background-color: #F0ECE4;">
                            <p class="has-text-weight-semibold">Monto:</p>
                            <p id="<%= modalId %>-montoValue" class="is-size-5 has-text-dark"></p>
                        </div>
                    </div>
                    <div class="column is-full" id="<%= modalId %>-notaModal">
                        <div class="box" style="border-left: 4px solid #800020; background-color: #F0ECE4;">
                            <p class="has-text-weight-semibold">Nota:</p>
                            <p id="<%= modalId %>-notaValue" class="is-size-5 has-text-dark"></p>
                        </div>
                    </div>

                    <!-- Campos para la tarjeta -->
                    <div class="column is-full">
                        <div class="box" style="border-left: 4px solid #8B4513; background-color: #F0ECE4;">
                            <p class="has-text-weight-semibold">Número de tarjeta:</p>
                            <input type="text" id="cardNumber" class="input" placeholder="Número de tarjeta" required>
                        </div>
                    </div>
                    <div class="column is-half">
                        <div class="box" style="border-left: 4px solid #8B4513; background-color: #F0ECE4;">
                            <p class="has-text-weight-semibold">Fecha de expiración:</p>
                            <input type="text" id="cardExpiration" class="input" placeholder="MM/AA" required>
                        </div>
                    </div>
                    <div class="column is-half">
                        <div class="box" style="border-left: 4px solid #8B4513; background-color: #F0ECE4;">
                            <p class="has-text-weight-semibold">CVV:</p>
                            <input type="text" id="cardCVV" class="input" placeholder="CVV" required>
                        </div>
                    </div>
                    <div class="column is-full">
                        <div class="box" style="border-left: 4px solid #8B4513; background-color: #F0ECE4;">
                            <p class="has-text-weight-semibold">Nombre en la tarjeta:</p>
                            <input type="text" id="cardHolderName" class="input" placeholder="Nombre del titular" required>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <footer class="modal-card-foot">
            <button class="button is-primary" type="submit" id="submitPayment">Confirmar Pago</button>
        </footer>
    </div>
</div>
