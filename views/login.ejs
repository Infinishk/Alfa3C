<!DOCTYPE html>
<html lang="es-MX">
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Alfa3C Pagos</title>
    <link rel="stylesheet" href="/css/alfa3C.css">
    <style>
        /* General */
        html, body {
            max-height: 1vh; 
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f0ece4;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Canvas de fondo en pantalla completa */
        #circle-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            pointer-events: none;
            background-color: #f0ece4;
        }

        #circle-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 10; /* Encima de todo */
            pointer-events: none;
        }

        /* Contenedor principal */
        .main-container {
            display: flex;
            width: 75vw;
            max-width: 900px;
            height: auto;
            background-color: #f0ece4;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        @media (max-width: 768px) {
            .main-container {
                flex-direction: column;
                width: 90%;
            }
        }

        /* Estilos del contenedor de inicio de sesión */
        .login-container {
            flex: 1;
            padding: 3rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background-color: #f0ece4;
            position: relative;
        }

        .login-container h1 {
            font-size: 24px;
            font-weight: bold;
            color: #333;
            margin-bottom: 10px;
        }

        .login-container p {
            color: #666;
            margin-bottom: 20px;
        }

        .form-container {
            width: 100%;
        }

        .field {
            margin-bottom: 1.5rem;
        }

        .label {
            color: #333;
            font-size: 14px;
        }

        .input {
            border: none;
            border-bottom: 1px solid #333;
            border-radius: 0;
            box-shadow: none;
            background-color: #f0ece4; 
        }

        .input:focus {
            border-color: #333;
            box-shadow: none;
        }

        .button.is-primary {
            background-color: #1d3557;
            color: #FFF;
            border: none;
            width: 100%;
        }

        /* Enlace de "Olvidaste tu contraseña?" */
        .link-reseteo {
            color: #000000;
            text-decoration: underline;
            font-size: 0.9rem;
        }

        /* Contenedor azul */
        .graphic-container {
            flex: 1;
            background-color: rgba(32, 79, 123, 1);
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: visible;
        }

        /* Canvas en primer plano para el contenedor azul */
        #circle-foreground {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        /* Canvases en primer plano para la parte superior e inferior del contenedor de inicio de sesión */
        #circle-foreground-top, #circle-foreground-bottom {
            position: absolute;
            left: 0;
            width: 100%;
            height: 50px;
            pointer-events: none;
        }

        #circle-foreground-top {
            top: -50px;
        }

        #circle-foreground-bottom {
            bottom: -50px;
        }

        /* Icono para mostrar/ocultar contraseña */
        .password-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .password-wrapper .icon {
            position: absolute;
            right: 10px;
            cursor: pointer;
            color: #333;
        }
    </style>
</head>

<body>
    <!-- Canvas de círculos de fondo -->
    <canvas id="circle-background"></canvas>
    <canvas id="circle-overlay"></canvas>

    <div class="main-container">
        <div class="login-container" id="login-container">
            <a class="image">
                <img src="/images/iconoNegro.png" alt="Logo" style="width: 40px; height: 40px;">
            </a>
            <h1>Iniciar sesión</h1>
            <p>Un gusto tenerte de regreso.</p>

            <div class="form-container">
                <form action="/auth/login" method="post" class="lg-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <% if (error) { %>
                    <div class="notification is-danger">
                        <strong> <%= error %></strong>
                    </div>
                    <% } %>

                    <div class="field">
                        <label class="label" for="IDUsuario">Usuario o correo</label>
                        <div class="control">
                            <input class="input" type="text" name="IDUsuario" id="IDUsuario" required />
                        </div>
                    </div>

                    <div class="field">
                        <label class="label" for="password">Contraseña</label>
                        <div class="control password-wrapper">
                            <input class="input" type="password" name="password" id="password" required />
                            <span class="icon is-right">
                                <i id="toggle-password-icon" class="fas fa-eye"></i>
                            </span>
                        </div>
                    </div>                    

                    <div class="field">
                        <input type="submit" class="button is-primary" value="Iniciar Sesión"/>
                    </div>
                    <a href="/auth/reset_password" class="link-reseteo">¿Olvidaste tu contraseña?</a> 
                </form>
            </div>
        </div>

        <!-- Contenedor azul con canvas en primer plano para círculos que se intersectan -->
        <div class="graphic-container" id="blue-container">
            <canvas id="circle-foreground"></canvas>
        </div>
    </div>

<script src="/js/login.js"></script>
</body>
</html>
