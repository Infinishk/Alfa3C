<!DOCTYPE html>
<html lang="es-MX">
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Alfa3C Pagos</title>
    <link rel="stylesheet" href="/css/alfa3C.css">
    <style>
        /* General */
        html, body {
            height: 100%;
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f0ece4;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Full-screen canvas */
        #circle-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            pointer-events: none;
            background-color: #f0ece4;
        }

        /* Login */
        .main-container {
            display: flex;
            width: 75vw;
            max-width: 900px;
            height: auto;
            background-color: #f0ece4;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            
        }

        @media (max-width: 768px) {
            .main-container {
                flex-direction: column; /* Stack elements vertically */
                width: 90%; /* Slightly reduce width on smaller screens */
            }
        }

        /* Contenedor de informacion */
        .login-container {
            flex: 1;
            padding: 3rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background-color: #f0ece4;
        }

        /* Titulo, subtitulo */
        .login-container h1 {
            font-size: 24px;
            font-weight: bold;
            color: #333;
            margin-bottom: 10px;
        }

        .login-container p {
            color: #666;
            margin-bottom: 20px;
        }

        .form-container {
            width: 100%;
        }

        .field {
            margin-bottom: 1.5rem;
        }

        .label {
            color: #333;
            font-size: 14px;
        }

        .input {
            border: none;
            border-bottom: 1px solid #333;
            border-radius: 0;
            box-shadow: none;
            background-color: #f0ece4; 
        }

        .input:focus {
            border-color: #333;
            box-shadow: none;
        }

        .button.is-primary {
            background-color: #1d3557;
            color: #FFF;
            border: none;
            width: 100%;
        }

        /* Olvidaste tu contraseña? */
        .link-reseteo {
            color: #000000;
            text-decoration: underline;
            font-size: 0.9rem;
        }

        /* ayuda por favor (contenedor de las formas) */
        .graphic-container {
            flex: 1;
            background-color: #204f7b;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        /* Switch de ver contraseña */
        .switch-label {
            color: #000;
        }
        /* Full-screen canvas */
        #circle-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1; /* Make sure it sits behind other elements */
            pointer-events: none; /* Prevent interactions with canvas */
            background-color: #f0ece4; /* Optional background color */
        }

        .password-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .password-wrapper .icon {
            position: absolute;
            right: 10px;
            cursor: pointer;
            color: #333;
        }


    </style>
</head>

<body>
    <canvas id="circle-background"></canvas>
    <div class="main-container">
        <div class="login-container">
            <a class="image">
                <img src="/images/iconoNegro.png" alt="Logo" style="width: 40px; height: 40px;">
            </a>
            <h1>Iniciar sesión</h1>
            <p>Un gusto tenerte de regreso.</p>

            <div class="form-container">
                <form action="/auth/login" method="post" class="lg-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <% if (error) { %>
                    <div class="notification is-danger">
                        <strong> <%= error %></strong>
                    </div>
                    <% } %>

                    <div class="field">
                        <label class="label" for="IDUsuario">Usuario o correo</label>
                        <div class="control">
                            <input class="input" type="text" name="IDUsuario" id="IDUsuario" required />
                        </div>
                    </div>

                    <div class="field">
                        <label class="label" for="password">Contraseña</label>
                        <div class="control password-wrapper">
                            <input class="input" type="password" name="password" id="password" required />
                            <span class="icon is-right">
                                <i id="toggle-password-icon" class="fas fa-eye"></i>
                            </span>
                        </div>
                    </div>                    

                    <div class="field">
                        <input type="submit" class="button is-primary" value="Iniciar Sesión"/>
                    </div>
                    <a href="/auth/reset_password" class="link-reseteo">¿Olvidaste tu contraseña?</a> 
                </form>
            </div>
        </div>

        <div class="graphic-container" id="blue-container"></div>

    </div>

<script src="/js/login.js"></script>
</body>
</html>

