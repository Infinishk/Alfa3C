<!DOCTYPE html>
<html lang="es-MX">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Alfa3C Pagos</title>
    <link rel="stylesheet" href="/css/alfa3C.css">
    <style>
        /* General */
        html, body {
            height: 100%;
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f0ece4;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Login */
        .main-container {
            display: flex;
            width: 900px;
            height: 500px;
            background-color: #f0ece4;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

        /* Contenedor de informacion */
        .login-container {
            flex: 1;
            padding: 3rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background-color: #f0ece4;
        }

        /* Titulo, subtitulo */
        .login-container h1 {
            font-size: 24px;
            font-weight: bold;
            color: #333;
            margin-bottom: 10px;
        }

        .login-container p {
            color: #666;
            margin-bottom: 20px;
        }

        .form-container {
            width: 100%;
        }

        .field {
            margin-bottom: 1.5rem;
        }

        .label {
            color: #333;
            font-size: 14px;
        }

        .input {
            border: none;
            border-bottom: 1px solid #333;
            border-radius: 0;
            box-shadow: none;
            background-color: #f0ece4; /* Updated color */
        }

        .input:focus {
            border-color: #333;
            box-shadow: none;
        }

        .button.is-primary {
            background-color: #1d3557;
            color: #FFF;
            border: none;
            width: 100%;
        }

        /* Olvidaste tu contraseña? */
        .link-reseteo {
            color: #000000;
            text-decoration: underline;
            font-size: 0.9rem;
        }

        /* ayuda por favor (contenedor de las formas) */
        .graphic-container {
            flex: 1;
            background-color: #204f7b;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        .graphic-container::before {
            content: "";
            position: absolute;
            width: 250px;
            height: 250px;
            background-color: #204f7b;
            border-radius: 50%;
            top: 50px;
            right: 80px;
        }

        .graphic-container::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            background-color: #204f7b;
            border-radius: 50%;
            top: 200px;
            right: 150px;
        }
    </style>
</head>

<body>
    <div class="main-container">
        <div class="login-container">
            <a class="image">
                <img src="/images/iconoNegro.png" alt="Logo" style="width: 40px; height: 40px;">
            </a>
            <h1>Iniciar sesión</h1>
            <p>Un gusto tenerte de regreso.</p>

            <div class="form-container">
                <form action="/auth/login" method="post" class="lg-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <% if (error) { %>
                    <div class="notification is-danger">
                        <strong> <%= error %></strong>
                    </div>
                    <% } %>

                    <div class="field">
                        <label class="label" for="IDUsuario">Usuario o correo</label>
                        <div class="control">
                            <input class="input" type="text" name="IDUsuario" id="IDUsuario" required />
                        </div>
                    </div>

                    <div class="field">
                        <label class="label" for="password">Contraseña</label>
                        <div class="control">
                            <input class="input" type="password" name="password" id="password" required />
                        </div>
                    </div>

                    <div class="field">
                        <input type="submit" class="button is-primary" value="Iniciar Sesión"/>
                    </div>
                    <a href="/auth/reset_password" class="link-reseteo">¿Olvidaste tu contraseña?</a> 
                </form>
            </div>
        </div>

        <div class="graphic-container"></div>
    </div>
</body>

</html>
