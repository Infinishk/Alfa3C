<%- include('../includes/head.ejs', { 
    username: username, 
    permisos: permisos, 
    rol: rol 
}) %>

<!-- Tab Navigation positioned above the container -->
<div class="tabs-container">
    <div class="tabs is-centered">
        <ul>
            <li id="tab-usuario" class="is-active"><a href="#">Usuario</a></li>
            <li id="tab-admin"><a href="#">Admin</a></li>
        </ul>
    </div>
</div>

<!-- Centered Container for Form -->
<div class="form-page-container-registrar form-width-50">
    <!-- Form Container -->
    <form action="/usuarios/registrarUsuario" method="POST" class="form-container-registrar">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- Fields for Both Admin and Usuario -->
        <div class="field">
            <label class="label">Nombre</label>
            <div class="control">
                <input class="input" type="text" name="nombre" id="nombre" required>
            </div>
        </div>

        <div class="field">
            <label class="label">Apellidos</label>
            <div class="control">
                <input class="input" type="text" name="apellidos" id="apellidos" required>
            </div>
        </div>

        <div class="field">
            <label class="label">Correo Electrónico</label>
            <div class="control">
                <input class="input" type="email" name="correoElectronico" id="correoElectronico" required>
            </div>
        </div>

        <div id="usuario-fields">
            <div class="field">
                <label class="label">Tipo de Cliente</label>
                <div class="control">
                    <div class="select">
                        <select name="tipoCliente" id="tipoCliente" required>
                            <option value="Persona Fisica">Persona Física</option>
                            <option value="Persona Moral">Persona Moral</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="field">
                <label class="label">Direccion</label>
                <div class="control">
                    <input class="input" type="text" name="direccion" id="direccion" required>
                </div>
            </div>

            <div class="field">
                <label class="label">Telefono</label>
                <div class="control">
                    <input class="input" type="text" name="telefono" id="telefono" required>
                </div>
            </div>

            <div class="field">
                <label class="label">RFC</label>
                <div class="control">
                    <input class="input" type="text" name="rfc" id="rfc" required>
                </div>
            </div>

            <div class="field">
                <label class="label">Referencia Bancaria</label>
                <div class="control">
                    <input class="input" type="text" name="referenciaBancaria" id="referenciaBancaria" required>
                </div>
            </div>

            <div class="field">
                <label class="label">Porcentaje Interés (%)</label>
                <div class="control">
                    <input class="input" type="text" name="porcentajeInteres" id="porcentajeInteres" required>
                </div>
            </div>

            <div class="field">
                <label class="label">Monto Retencion</label>
                <div class="control">
                    <input class="input" type="text" name="montoRetencion" id="montoRetencion" required>
                </div>
            </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="button is-primary is-fullwidth" id="registrar">Registrar</button>
        <p id="mensajeError" class="help is-danger"></p>
    </form>
</div>

<script src="/../js/registrarUsuario.js"></script>

<%- include('../includes/foot.ejs') %>
