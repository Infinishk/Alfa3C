<%- include('../includes/head.ejs', { permisos: permisos, rol: rol}) %>

<body>
    <section class="section">
        <div class="columns is-flex is-justify-content-space-between">
            <div class="column is-6">
                <label class="label is-large has-text-strong has-text-weight-semibold">
                    INQUILINO: <%= inquilino.Nombre %> <%= inquilino.Apellidos %> - <%= inquilino.RFC %>
                </label>
            </div>

            <input type="hidden" name="_csrf" id="_csrf" value="<%= csrfToken %>">

            <div class="column is-narrow is-justify-content-flex-end">
                <p class="control">
                    <a class="button is-responsive is-primary" style="font-size: large;"
                        href="/pagos/fetchRegistrarPagoManual">
                        <span class="icon is-large">
                            <i class="fa-solid fa-circle-plus" style="color: #FFFF;"></i>
                        </span>
                        <span>
                            Registrar Pago Manual
                        </span>
                    </a>
                </p>
            </div>
        </div>

        <!-- Columna vertical para datos personales -->
        <div class="container ml-3">
            <div class="columns is-flex is-align-items-flex-start" id="inquilinoInfo">
                <div class="columns is-flex is-flex-direction-column is-align-items-flex-start" id="datosPersonales">
                    <div class="column">
                        <div class="box" style="text-align: center; width: 200px">
                            <p class="has-text-grey has-text-weight-medium">TIPO DE CLIENTE</p>
                            <p class="has-text-black has-text-weight-bold is-size-5">
                                <%= inquilino.TipoCliente %></p>
                        </div>
                    </div>
                    <div class="column">
                        <div class="box" style="text-align: center; width: 200px">    
                            <p class="has-text-grey has-text-weight-medium">REFERENCIA BANCARIA</p>
                            <p class="has-text-black has-text-weight-bold is-size-5">
                                <%= inquilino.ReferenciaBancaria %></p>
                        </div>
                    </div>
                    <div class="column">
                        <div class="box" style="text-align: center; width: 200px">
                            <p class="has-text-grey has-text-weight-medium">PORCENTAJE DE INTERÉS</p>
                            <p class="has-text-black has-text-weight-bold is-size-5">
                                <%= inquilino.PorcentajeInteres %>%</p>
                        </div>
                    </div>
                    <div class="column">
                        <div class="box" style="text-align: center; width: 200px">
                            <p class="has-text-grey has-text-weight-medium">MONTO DE RETENCIÓN</p>
                            <p class="has-text-black has-text-weight-bold is-size-5">
                                $<%= inquilino.MontoRetencion %> </p>
                        </div>
                    </div>
                    <div class="column">
                        <div class="box" style="text-align: center; width: 200px">
                            <p class="has-text-grey has-text-weight-medium">TELEFÓNO</p>
                            <p class="has-text-black has-text-weight-bold is-size-5">
                                <%= inquilino.Teléfono %> </p>
                        </div>
                    </div>
                    <div class="column">
                        <div class="box" style="text-align: center; width: 200px">
                            <p class="has-text-grey has-text-weight-medium">DIRECCIÓN</p>
                            <p class="has-text-black has-text-weight-bold is-size-5">
                                <%= inquilino.Direccion %> </p>
                        </div>
                    </div>
                    <div class="column">
                        <button class="button is-responsive is-primary is-fullwidth" style="font-size: large; width: 200px;"
                            type="submit" id="btn_modificarDatos" disabled>
                                <span>Modificar Datos</span>
                        </button>
                    </div>
                </div>

            <!-- Tabs para datos financieros -->
             <div class="column">
                <div id="datosFinancieros" class="columns is-flex is-flex-direction-column" style="margin-left: 7px;">
                    <div class="tabs is-boxed">
                        <ul>
                            <li class="is-active" id="tab_edoCuenta">
                                <a>
                                    <span class="icon is-small"><i class="fa-solid fa-clipboard-list"></i></span>
                                    <h2> Estado de Cuenta </h2>
                                </a>
                            </li>
                            <li id="tab_historial">
                                <a>
                                    <span class="icon is-small"><i class="fa-solid fa-clock-rotate-left"></i></span>
                                    <h2> Historial de Pago </h2>
                                </a>
                            </li>
                            <li id="tab_contratos">
                                <a>
                                    <span class="icon is-small"><i class="fa-solid fa-file-circle-check"></i></span>
                                    <h2> Contratos Asignados </h2>
                                </a>
                            </li>
                        </ul>
                    </div>

                <!-- Estado de Cuenta -->
                <div id="edoCuenta">
                    <% if (Object.keys(rentasPorContrato).length != 0) { %>
                        <% for (let id in rentasPorContrato) {
                            let contratoRenta = contratos.find(c => c.IDDetalleContrato === id); %>
                            <div id="pagination-content">
                            <div class="box is-fullwidth" style="text-align: left; margin-bottom: 15px;">
                                <div class="columns is-flex is-justify-content-space-between">
                                    <div class="column">
                                        <label class="label is-medium has-text-danger has-text-weight-semibold" style="margin-bottom: 0;">
                                            <%= contratoRenta.Nombre %>
                                        </label>
                                    </div>
                                    <div class="column is-narrow has-text-right">
                                        <form action="/inquilino/modificarFichas" method="POST" class="is-inline">
                                            <input type="hidden" name="_csrf" id="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" value="<%= contratos.IDDetalleContrato %>" name="idContrato" id="idContrato">
                                            <input type="hidden" value="<%= inquilino.IDCliente %>" name="idCliente" id="idCliente">
                                            <button class="button is-primary is-danger" type="submit">
                                                <span>Modificar Fichas</span>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                                    <div class="table-container">
                                        <table class="table is-fullwidth is-hoverable">
                                            <thead>
                                                <tr>
                                                    <th style="text-align: center;">Mes</th>
                                                    <th style="text-align: center;">Total</th>
                                                    <th style="text-align: center;">Inflación</th>
                                                    <th style="text-align: center;">Recargos</th>
                                                    <th style="text-align: center;">Ajuste</th>
                                                    <th style="text-align: center;">Fecha Límite de Pago</th>
                                                    <th style="text-align: center;">Estatus</th>
                                                </tr>
                                            </thead>
                                        <tbody>
                                            <% rentasPorContrato[id].forEach((renta, count) => { %>
                                                <tr>
                                                    <td style="text-align: center;"> #<%=count + 1 %></td>
                                                    <td style="text-align: center;"> $<%= renta.MontoPagado %> </td>
                                                    <td style="text-align: center;"> <%= renta.MontoInflacion %></td>
                                                    <td style="text-align: center;"> $<%= renta.Recargos %></td>
                                                    <td style="text-align: center;"> $<%= renta.Ajuste %></td>
                                                    <%  const fechaActual = new Date();
                                                        const fecha = new Date(renta.FechaLimite); 
                                                        const fechaLimite = fecha.toLocaleString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' }); %>
                                                    <td  style="text-align: center;"> <%= fechaLimite %></td>
                                                    <% if (renta.Pagado == 1) { %>
                                                        <td style="text-align: center;">
                                                            <span class="tag is-size-6" style="background-color: #ddf5e5;">
                                                                <span class="icon is-small" style="color: #21c85b">
                                                                    <i class="fa-solid fa-circle-check"></i>
                                                                </span>
                                                                <span style="color: #21c85b !important;">
                                                                    Pagado
                                                                </span>
                                                            </span>
                                                        </td>
                                                    <% } else if (fecha.getTime() > fechaActual.getTime()) { %>
                                                        <td style="text-align: center;">
                                                            <span class="tag is-size-6" style="background-color: #fdf2cc">
                                                                <span class="icon is-small" style="color: #fec416">
                                                                    <i class="fa-solid fa-clock"></i>
                                                                </span>
                                                                <span style="color: #fec416 !important;">
                                                                    Pendiente
                                                                </span>
                                                            </span>
                                                        </td>
                                                    <% } else { %>
                                                        <td style="text-align: center;">
                                                            <span class="tag is-size-6" style="background-color: #f6d5d8">
                                                                <span class="icon is-small" style="color: #f83362">
                                                                    <i class="fa-solid fa-circle-xmark"></i>
                                                                </span>
                                                                <span style="color: #f83362 !important;">
                                                                    Atrasado
                                                                </span>
                                                            </span>
                                                        </td>
                                                    <% } %> <!-- termina loop Pagado -->
                                                </tr>
                                            <% }) %> <!-- termina loop poblar tabla-->
                                        </tbody>
                                    </table>
                                </div>
                                </div>
                            </div>
                        <% } %> <!-- termina crear tabla por un contrato -->
                        <!-- Pagination -->
                        <nav class="pagination is-rounded" role="navigation" aria-label="pagination">
                            <a class="pagination-previous" id="prev-button">Anterior</a>
                            <a class="pagination-next" id="next-button">Siguiente</a>
                            <ul class="pagination-list" id="pagination-list">
                                <div id="pagination-numbers"></div>
                            </ul>
                        </nav>
                    <% } else { %> <!-- termina loop si hay rentas -->
                    <div class="columns">
                        <div class="column is-fullwidth">
                            <div class="notification-info">
                                El cliente no tiene rentas activas en este momento.
                            </div>
                        </div>
                    </div> 
                    <% } %>
                </div>

                <!-- Historial de Pagos -->
                <div id="historial" class="is-hidden">
                    <% if (pagos.length != 0) { %>
                    <div class="box is-fullwidth" style="text-align: left; margin-bottom: 15px;">
                        <div class="table-container">
                            <table class="table is-fullwidth is-hoverable">
                                <thead>
                                    <tr>
                                        <th style="text-align: center;">Monto</th>
                                        <th style="text-align: center;">Fecha</th>
                                        <th style="text-align: center;">Motivo</th>
                                        <th style="text-align: center;">Método</th>
                                        <th style="text-align: center;">Nota</th>
                                    </tr>
                                </thead>
                                <tbody>
                                <% for (let pago of pagos) { %>
                                    <tr>
                                        <td style="text-align: center;"> $<%= pago.MontoPagado %></td>
                                        <td style="text-align: center;"> <%= pago.FechaPago.toLocaleString('es-MX', 
                                            { year: 'numeric', month: 'long', day: 'numeric' }) %></td>
                                        <td style="text-align: center;"> <%= pago.Motivo %></td>
                                        <td style="text-align: center;"> <%= pago.MetodoPago %></td>
                                        <td style="text-align: center;"> <%= pago.Nota %></td>
                                    </tr>
                                <% } %>
                                </tbody>
                            </table>
                        </div> 
                    </div>
                    <% } else { %>
                        <div class="columns">
                            <div class="column is-fullwidth">
                                <div class="notification-info">
                                    El cliente aún no ha realizado pagos.
                                </div>
                            </div>
                        </div> 
                    <% } %> %>
                </div>

                <!-- Contratos / Modificar Fichas -->
                <div id="contratos" class="is-hidden">
                    <% if (contratos.length != 0) { %>
                        <div class="columns is-flex is-justify-content-flex-end">
                            <div class="column is-narrow">
                                <p class="control">
                                    <a class="button is-responsive is-primary" style="font-size: large;"
                                        href="/contrato/asignarContrato">
                                        <span class="icon is-large">
                                            <i class="fa-solid fa-circle-plus" style="color: #FFFF;"></i>
                                        </span>
                                        <span> Asignar Contrato </span>
                                    </a>
                                </p>
                            </div>
                        </div>                    
                    
                        <% for (let contrato of contratos) { %>
                        <div class="box is-fullwidth" style="text-align: left; margin-bottom: 15px;">
                            <div class="columns is-flex is-justify-content-space-between">
                                <div class="column is-narrow">
                                    <p class="has-text-black has-text-weight-bold is-size-6"><%= contrato.Nombre %></p>
                                </div>
                                <div class="column is-narrow">
                                    <p class="has-text-grey has-text-weight-medium"><b>Inflación:</b> <%= contrato.PorcentajeInflacion %>% </p>
                                </div>
                                <div class="column is-narrow">
                                    <p class="has-text-grey has-text-weight-medium"><b>Fecha Inflación:</b> <%= contrato.FechaInflacion.toLocaleString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                                </div>
                            </div>   
                        </div>
                        <% } %>
                    <% } else { %>
                        <div class="columns">
                            <div class="column is-fullwidth">
                                <div class="notification-info">
                                    El cliente no tiene contratos asignados en este momento. Para asignar un contrato, por favor haz click <a href="/contrato/asignarContrato"> aquí </a>.
                                </div>
                            </div>
                        </div> 
                    <% } %>
                </div>

            </div>
        </div>
    </section>
</body>

<script type="text/javascript" src="/js/inquilino/consultarInquilino.js"></script>
<script type="text/javascript" src="/js/pagination.js"></script>

<%- include('../includes/foot.ejs') %>