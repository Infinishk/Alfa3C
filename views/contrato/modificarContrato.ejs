<%- include('../includes/head.ejs', { permisos: permisos, rol: rol }) %>

    <style>
        .form-container {
            max-width: 600px;
            margin: 40px auto;
            background-color: #fff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        h1 {
            font-weight: bold;
            color: #204F7B;
            text-align: center;
            font-size: 25px;
        }

        label {
            font-weight: bold;
            display: block;
            margin-bottom: 5px;
            color: black;
        }

        input[type="text"],
        input[type="number"] {
            width: 100%;
            padding: 10px;
            margin-bottom: 20px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        #errorMessage {
            color: #204F7B;
            font-size: 0.9em;
            margin-top: 10px;
            margin-left: 10px;
            display: none;
        }
    </style>

    <body>

        <% if (fetch) { %>
            <p class="title" style="text-align: center;">Buscar Contrato</p>
            <form action="/contrato/fetchContrato" method="POST" style="width: 50%; margin-top: 50px;">
                <input type="hidden" name="_csrf" id="_csrf" value="<%= csrfToken %>">
                <label for="nombre" class="label is-large">Nombre del Contrato:</label>
                <input type="text" id="titulo" name="titulo" required class="input is-large">
                <br>
                <br>
                <button type="submit" id="buscarBtn" class="button is-rounded is-large is-responsive">Buscar</button>
                <p id="mensajeValidacion" class="help is-danger"></p>
            </form>
            <% if (error) { %>
                <p class="is-size-4">
                    <%= error %>
                </p>
                <% } %>
                    <% } %>

                        <% if (editar) { %>
                            <div class="form-container">
                                <h1>Modificar Datos del Contrato</h1>
                                <form action="/contrato/registrarContrato" method="POST">
                                    <input type="hidden" name="_csrf" id="_csrf" value="<%= csrfToken %>">

                                    <%- include('../components/inputs/textInput.ejs', {
                                        id: 'razonSocial',
                                        name: 'razonSocial',
                                        label: 'Razon Social',
                                        placeholder: 'Referencia Bancaria a donde se paga',
                                        value: razonSocial.ReferenciaBancaria,
                                        icon: 'fa-solid fa-building', 
                                        iconColor: 'has-text-primary',
                                        maxChars: 10
                                    }) %>

                                    <%- include('../components/inputs/textInput.ejs', {
                                        id: 'nombreEmpresa',
                                        name: 'nombreEmpresa',
                                        label: 'Nombre de la Empresa',
                                        placeholder: '',
                                        value: razonSocial.NombreEmpresa ,
                                        icon: 'fa-solid fa-building', 
                                        iconColor: 'has-text-primary',
                                        maxChars: 20
                                    }) %>

                                    <%- include('../components/inputs/textInput.ejs', {
                                        id: 'titulo',
                                        name: 'titulo',
                                        label: 'Título del Contrato',
                                        placeholder: '',
                                        value: contrato.Titulo ,
                                        icon: 'fa-solid fa-file-contract', 
                                        iconColor: 'has-text-primary',
                                        maxChars: 20
                                    }) %>

                                    <%- include('../components/inputs/numberInput.ejs', {
                                        id: 'numMeses',
                                        name: 'numMeses',
                                        label: 'Número de Meses',
                                        placeholder: '',
                                        value: contrato.DuracionMeses,
                                        icon: 'fa-solid fa-calendar-alt',
                                        iconColor: 'has-text-primary'
                                    }) %>

                                    <!-- Contenedor del botón y el mensaje -->
                                    <div style="display: flex; align-items: center;">
                                        <button id="submitBtn" type="submit" class="button is-primary">Registrar
                                            Contrato</button>
                                        <span id="errorMessage">Por favor ingresa correctamente todos los datos</span>
                                    </div>
                                </form>
                            </div>
                            <% } %>

    </body>

    <script type="text/javascript" src="/js/contrato/registrarContrato.js"></script>
    <script type="text/javascript" src="/js/contrato/modificarContrato.js"></script>
    <%- include('../includes/foot.ejs') %>