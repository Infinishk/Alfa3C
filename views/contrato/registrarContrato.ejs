<%- include('../includes/head.ejs', { permisos: permisos, rol: rol }) %>

<style>
    .form-container {
        max-width: 600px;
        margin: 40px auto;
        background-color: #fff;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
    h1 {
        font-weight: bold;
        color: #204F7B;
        text-align: center;
        font-size: 25px;
    }
    label {
        font-weight: bold;
        display: block;
        margin-bottom: 5px;
        color: black;
    }
    input[type="text"],
    input[type="number"]{
        width: 100%;
        padding: 10px;
        margin-bottom: 20px;
        border: 1px solid #ccc;
        border-radius: 5px;
    }
    .form-group {
        margin-bottom: 15px;
    }

    /* Estilo del mensaje de advertencia */
    #errorMessage {
        color: #204F7B;
        font-size: 0.9em;
        margin-top: 10px;
        margin-left: 10px;
        display: none; /* Oculto por defecto */
    }
</style>

<body>

    <div class="form-container">
        <h1>Ingresa Datos del Contrato</h1>
        <form action="/contrato/registrarContrato" method="POST">
            <input type="hidden" name="_csrf" id="_csrf" value="<%= csrfToken %>">
            
            <%- include('../components/inputs/textInput.ejs', {
                id: 'razonSocial',
                name: 'razonSocial',
                label: 'Razon Social',
                placeholder: '',
                value: '' ,
                icon: 'fa-solid fa-building', 
                iconColor: 'has-text-primary',
                maxChars: 10
            }) %>
            
            <%- include('../components/inputs/textInput.ejs', {
                id: 'nombreEmpresa',
                name: 'nombreEmpresa',
                label: 'Nombre de la Empresa',
                placeholder: '',
                value: '' ,
                icon: 'fa-solid fa-building', 
                iconColor: 'has-text-primary',
                maxChars: 20
            }) %>

            <%- include('../components/inputs/textInput.ejs', {
                id: 'titulo',
                name: 'titulo',
                label: 'Título del Contrato',
                placeholder: '',
                value: '' ,
                icon: 'fa-solid fa-file-contract', 
                iconColor: 'has-text-primary',
                maxChars: 20
            }) %>
            
            <%- include('../components/inputs/numberInput.ejs', {
                id: 'numMeses',
                name: 'numMeses',
                label: 'Número de Meses',
                placeholder: '',
                value: '',
                icon: 'fa-solid fa-calendar-alt',
                iconColor: 'has-text-primary'
            }) %>

            <!-- Contenedor del botón y el mensaje -->
            <div style="display: flex; align-items: center;">
                <button id="submitBtn" type="submit" class="button is-primary" disabled>Registrar Contrato</button>
                <span id="errorMessage">Por favor ingresa correctamente todos los datos</span>
            </div>
        </form>
    </div>

</body>

<script type="text/javascript" src="/js/contrato/registrarContrato.js"></script>
<%- include('../includes/foot.ejs') %>
